APP_ENV=development
WEB_PORT=8080
# 学习站源码已包含在本仓库；一般无需修改。
LEARNING_SITE_CONTEXT=./learning-site
# 可选：反向代理域名（仅 origin，不含 /learn），用于学习站分享图片的绝对 URL。
# 留空时使用 http://127.0.0.1:${WEB_PORT}；修改后需重新构建 nginx。
LEARNING_SITE_ORIGIN=
DATABASE_URL=sqlite:///./data/market_intel.db
REPORT_DIR=./data/reports
RAW_DIR=./data/raw
DEFAULT_TIMEZONE=Asia/Shanghai
COLLECTOR_SERVICE_URL=
ANALYSIS_SERVICE_URL=

# 可选：使用 Browser Use 云模型时填写。留空会复用下面的通用 AI 配置。
BROWSER_USE_API_KEY=

# AI Key 可选：不填仍可运行普通网页采集、去重、统计和 HTML 报告。
# Browser Use 交互采集和 PandasAI 自然语言问答需要 Key。
# 默认使用 DeepSeek；Key 只保存在本机 .env，不要提交到 Git。
AI_PROVIDER=deepseek
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash

# OpenAI 示例（使用时替换上面四项，不要同时保留两套 AI_*）：
# AI_PROVIDER=openai
# AI_API_KEY=your_openai_api_key
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=your_available_openai_model_id
#
# 其他 OpenAI 兼容服务：AI_PROVIDER 使用 openai，并按服务商文档填写
# AI_BASE_URL、AI_MODEL 和 AI_API_KEY。并非所有兼容接口都支持 Browser Use 工具调用。

# 旧版 OpenAI 配置兼容项；使用上面的通用 AI 配置时留空。
OPENAI_API_KEY=

# n8n 正式部署必须替换为随机长字符串
N8N_ENCRYPTION_KEY=change-this-to-a-long-random-string
POSTGRES_DB=market_intel
POSTGRES_USER=market_intel
POSTGRES_PASSWORD=change-this-password
