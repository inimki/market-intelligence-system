APP_ENV=development
DATABASE_URL=sqlite:///./data/market_intel.db
REPORT_DIR=./data/reports
RAW_DIR=./data/raw
DEFAULT_TIMEZONE=Asia/Shanghai
COLLECTOR_SERVICE_URL=
ANALYSIS_SERVICE_URL=

# 可选：使用 Browser Use 云模型时填写。留空会复用下面的通用 AI 配置。
BROWSER_USE_API_KEY=

# PandasAI 默认使用 DeepSeek。Key 只保存在本机 .env，不要提交到 Git。
AI_PROVIDER=deepseek
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash

# 旧版 OpenAI 配置兼容项；使用上面的通用 AI 配置时留空。
OPENAI_API_KEY=

# n8n 正式部署必须替换为随机长字符串
N8N_ENCRYPTION_KEY=change-this-to-a-long-random-string
POSTGRES_DB=market_intel
POSTGRES_USER=market_intel
POSTGRES_PASSWORD=change-this-password
